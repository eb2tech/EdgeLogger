<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:EdgeLogger.Mobile.PageModels"
             xmlns:resources="clr-namespace:EdgeLogger.Mobile.Resources.Fonts"
             x:Class="EdgeLogger.Mobile.Pages.WiFiProvisioningPage"
             x:DataType="pageModels:WiFiProvisioningPageModel"
             Title="WiFi Provisioning">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Connection Status Bar -->
            <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}"
                    StrokeThickness="1"
                    Padding="15"
                    StrokeShape="RoundRectangle 8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Scan for Pi"
                            Command="{Binding ScanForPiCommand}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InvertedBoolConverter}}"
                            HorizontalOptions="Fill" />
                    
                    <Border Grid.Column="1"
                            WidthRequest="30"
                            HeightRequest="30"
                            StrokeThickness="0"
                            BackgroundColor="{Binding ConnectionIndicatorColor}"
                            StrokeShape="Ellipse"
                            VerticalOptions="Center">
                        <Label Text="?"
                               FontSize="18"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Status Message -->
            <Label Text="{Binding StatusMessage}"
                   FontSize="16"
                   FontAttributes="Italic"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />

            <!-- WiFi Credentials Form -->
            <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}"
                    StrokeThickness="1"
                    Padding="20"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="15">
                    
                    <Label Text="WiFi Credentials"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <!-- SSID Entry -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="SSID" />
                        <Entry Text="{Binding Ssid}"
                               Placeholder="Enter WiFi network name"
                               IsEnabled="{Binding IsProvisioning, Converter={StaticResource InvertedBoolConverter}}" />
                    </VerticalStackLayout>

                    <!-- Password Entry -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Password" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                            <Entry Grid.Column="0"
                                   Text="{Binding Password}"
                                   Placeholder="Enter WiFi password"
                                   IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolConverter}}"
                                   IsEnabled="{Binding IsProvisioning, Converter={StaticResource InvertedBoolConverter}}" />
                            <ImageButton Grid.Column="1"
                                         Command="{Binding TogglePasswordVisibilityCommand}"
                                         WidthRequest="40"
                                         HeightRequest="40"
                                         VerticalOptions="Center"
                                         BackgroundColor="Transparent">
                                <ImageButton.Source>
                                    <FontImageSource FontFamily="FluentUI"
                                                     Glyph="{x:Static resources:FluentUI.Eye_20_Regular}"
                                                     Color="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                                                     Size="20" />
                                </ImageButton.Source>
                            </ImageButton>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Provision Button -->
                    <Button Text="Provision WiFi"
                            Command="{Binding ProvisionWiFiCommand}"
                            HorizontalOptions="Fill"
                            Margin="0,10,0,0"
                            FontAttributes="Bold" />

                </VerticalStackLayout>
            </Border>

            <!-- Instructions -->
            <Border Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    StrokeThickness="1"
                    Padding="15"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{AppThemeBinding Light=#F0F8FF, Dark=#1A2332}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Instructions"
                           FontSize="16"
                           FontAttributes="Bold" />
                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="1. Tap 'Scan for Pi' to find your device&#x0a;" />
                                <Span Text="2. Enter your WiFi network name (SSID)&#x0a;" />
                                <Span Text="3. Enter your WiFi password&#x0a;" />
                                <Span Text="4. Tap 'Provision WiFi' to configure the Pi&#x0a;&#x0a;" />
                                <Span Text="The Pi will automatically connect and stop advertising." FontAttributes="Italic" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
